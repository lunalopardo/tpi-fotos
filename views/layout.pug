doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Fotaza 2
    link(rel="stylesheet" href="/css/styles.css")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200")
    link(rel="icon" type="image/png" href="/images/F2.png")

  body
    nav.navbar
      .navbar-left
        a.navbar-brand(href="/")
          img.navbar-logo(src="/images/logo2.png" alt="Fotaza 2 Logo")

      form.search-container(action="/buscar" method="GET")
        span.material-symbols-outlined.search-icon search
        input.search-input(type="text" name="busqueda" placeholder="Buscar publicaciones o usuarios..")
        button.btn-search-submit(type="submit") Buscar

      .navbar-right
        if session && session.usuario
          a.btn-upload(href="/publicacion/nuevo") Crear Publicación
          ul.navbar-actions
            li: a.nav-icon-link(href="/" title="Notificaciones"): span.material-symbols-outlined notifications
            li: a.nav-icon-link(href="/" title="Mis Favoritos"): span.material-symbols-outlined favorite
            li: a.nav-icon-link(href="/usuario/perfil" title="Mi Perfil"): span.material-symbols-outlined account_circle
            li: a.nav-icon-link(href="/auth/logout" title="Cerrar Sesión" style="color: #e74c3c;"): span.material-symbols-outlined logout
        else
          a.btn-login(href="/auth/login") Iniciar Sesión

    main.container
      block styles
      block content