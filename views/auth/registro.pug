doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Crear Cuenta - Fotaza 2
    link(rel="stylesheet", href="/css/styles.css")
  body
    div.auth-wrapper(style = "margin: 200px auto")
      div.auth-header
        h1.auth-title Crear Cuenta
        p.auth-subtitle Crea tu cuenta para empezar a compartir

      if error
        div.alert-error
          p= error

      form(action="/auth/registro" method="POST")
        
        div.form-group
          label.form-label Nombre de Usuario
          input.form-input(
            type="text" 
            name="nombre_usuario" 
            value=(formValues ? formValues.nombre_usuario : '') 
            required 
            placeholder="Ej: luna_fotos"
          )
        
        div.form-group
          label.form-label Email Electrónico
          input.form-input(
            type="email" 
            name="email" 
            value=(formValues ? formValues.email : '') 
            required 
            placeholder="nombre@correo.com"
          )
        
        div.form-group
          label.form-label Contraseña
          input.form-input(
            type="password" 
            name="contrasenia" 
            required 
            placeholder="••••••••"
          )

        button.btn-auth-submit(type="submit") Registrarme

      p.auth-footer ¿Ya tenés cuenta? 
        a(href="/auth/login") Login