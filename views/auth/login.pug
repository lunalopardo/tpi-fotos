extends ../layout

block content
  h1.page-title= titulo
  p.page-subtitle Ingresá tus credenciales para acceder a tu cuenta.

  if error
    div.alert-error
      p= error

  div.form-container
    form(action="/auth/login" method="POST")
      
      div.form-group
        label.form-label Correo Electrónico:
        input.form-input(
          type="email" 
          name="email" 
          value=(formValues ? formValues.email : '') 
          required
        )

      div.form-group
        label.form-label Contraseña:
        input.form-input(
          type="password" 
          name="contrasenia" 
          required
        )

      button.btn-submit(type="submit") Iniciar Sesión

    p.form-footer ¿No tenés cuenta aún? 
      a(href="/auth/registro") Registrate acá.