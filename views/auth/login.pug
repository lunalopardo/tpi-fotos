doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Iniciar Sesión - Fotaza 2
    link(rel="stylesheet", href="/css/styles.css")
  body
    div.auth-wrapper(style = "margin: 200px auto")
      div.auth-header
        h1.auth-title Iniciar Sesión
        p.auth-subtitle Ingresá tus credenciales de acceso

      if error
        div.alert-error
          p= error

      form(action="/auth/login" method="POST")
        
        div.form-group
          label.form-label Usuario o Correo electrónico
          input#identificador.form-input(type="text" name="identificador" value=(formValues ? formValues.identificador : '') placeholder="nombre_usuario")
        
        div.form-group
          label.form-label Contraseña
          input.form-input(
            type="password" 
            name="contrasenia" 
            required 
            placeholder="••••••••"
          )

        button.btn-auth-submit(type="submit") Iniciar Sesión

      p.auth-footer ¿No tenés cuenta aún? 
        a(href="/auth/registro") Registrate acá