extends ../layout

block content
    div.auth-wrapper(style="max-width: 550px;")
        div.auth-header
            h1.auth-title Crear nueva publicación
            p.auth-subtitle Comparte tus imágenes con la comunidad!

        if error
            div.alert-error
                p= error

        form(action="/publicacion/nuevo" method="POST")

            div.form-group
                label.form-label Seleccionar Imágenes
                input#img.form-input(
                    type="file" 
                    accept="image/*" 
                    multiple 
                    required
                    style="padding: 8px;"
                )

            div#imgsBase64

            div.form-group
                label.form-label Título de la Publicación
                input.form-input(
                    type="text" 
                    name="titulo" 
                    value=(formValues ? formValues.titulo : '') 
                    required 
                    placeholder="Ej: Atardecer en Merlo"
                )

            div.form-group
                label.form-label Descripción (Opcional)
                textarea.form-input(
                    name="descripcion" 
                    rows="3" 
                    placeholder="Cuéntanos un poco sobre esta foto.."
                    style="resize: none; font-family: inherit;"
                )= (formValues ? formValues.descripcion : '')

            div.form-group
                label.form-label Flores / Etiquetas (Separadas por comas)
                input.form-input(
                    type="text" 
                    name="etiquetas" 
                    value=(formValues ? formValues.etiquetas : '') 
                    placeholder="Ej: paisajes, naturaleza, argentina"
                )

            div.form-group
                label.form-label Licencia de Copyright
                select#copyright.form-input(name="copyright" required onchange="toggleWatermark()")
                    option(value="0" selected=(formValues && formValues.copyright === '0')) Sin Copyright (Uso Libre)
                    option(value="1" selected=(formValues && formValues.copyright === '1')) Con Copyright (Protegida)

            //- campo oculto, se muestra solo si eligen con Copyright
            div.form-group#watermark-group(style="display: none;")
                label.form-label(for="marca_agua_texto") Texto de la marca de agua
                input.form-input#marca_agua_texto(type="text" name="marca_agua_texto" placeholder="Ej: © Propiedad Intelectual 2026")

            div.form-group.checkbox-group
                input#permitir_comentarios(type="checkbox" name="permitir_comentarios" checked)
                label(for="permitir_comentarios") Permitir que otros usuarios dejen comentarios
            script.
                function toggleWatermark() {
                    const copyrightSelect = document.getElementById('copyright');
                    const watermarkGroup = document.getElementById('watermark-group');
                    if (copyrightSelect && copyrightSelect.value === '1') {
                        watermarkGroup.style.display = 'block';
                    } else if (watermarkGroup) {
                        watermarkGroup.style.display = 'none';
                        document.getElementById('marca_agua_texto').value = '';
                    }
                }

            button.btn-auth-submit(type="submit") Publicar Fotografía

    script(src="/js/publicacion.js")