extends ../layout

block styles 
  link(rel="stylesheet" href="../css/publicacion.css")

block content
  div.detail-container
    //- Galería de imágenes
    div.detail-media-section
      div.main-image-wrapper
        if foto.imagenes && foto.imagenes.length > 0
          img#current-image(src=foto.imagenes[0], alt=foto.titulo)
        else
          p Imagen no disponible

      if foto.imagenes && foto.imagenes.length > 1
        div.thumbnail-gallery
          each imgUrl, index in foto.imagenes
            img.thumb-img(src=imgUrl, alt=`Miniatura ${index + 1}`, onclick=`changeImage('${imgUrl}')`)

    //- Datos y acciones
    div.detail-info-section
      a.btn-close(href="javascript:history.back()") &times;
      
      div.author-row
        div.pfp-placeholder
          | #{foto.usuario && foto.usuario.nombre_usuario ? foto.usuario.nombre_usuario.charAt(0).toUpperCase() : 'F'}
        span.username
          if foto.usuario && foto.usuario.id_usuario
            a(href=`/usuario/${foto.usuario.id_usuario}` style="color: inherit; text-decoration: none;") @#{foto.usuario.nombre_usuario}
          else
            | @fotografo

      div.meta-box
        h1.detail-title= foto.titulo
        p.detail-description
          | #{foto.descripcion || 'Sin descripción disponible.'}

        div.detail-tags-row
          if foto.etiquetas
            each tag in foto.etiquetas.split(',')
              span.tag-badge ##{tag.trim()}

        div.copyright-badge-wrapper(style="margin-top: 10px; font-size: 13px; font-weight: 600;")
          if foto.copyright === 1
            span.photo-copyright-status.has-copyright Con Copyright
          else
            span.photo-copyright-status.no-copyright Sin Copyright

      //- ACCIONES (Falta implementar 'Me interesa')
      div.actions-box
        button.btn-action.btn-interest
          span.material-symbols-outlined handshake
          |   Me interesa

        form#form-valorar(action=`/publicacion/${foto.id_publicacion || foto.id}/valorar` method="POST")
          input#puntuacion-input(type="hidden" name="puntuacion" value="")

          div.rating-stars-container
            //- Pinta automáticamente la estrella que coincida con miVoto
            each estrella in [5, 4, 3, 2, 1]
              span.star-icon(data-value=estrella class=(foto.miVoto == estrella ? 'selected' : '')) ★
            
            span#rating-display.rating-number(style="color: #a0aec0; font-weight: bold; font-size: 18px;") #{foto.promedioFormateado || '0.0'} (#{foto.cantidadVotos || 0})

        button.btn-action.btn-fav
          span.material-symbols-outlined favorite

      div.comments-box
        h3 Comentarios

        if foto.comentarios_cerrados === 1
          p.comments-closed-msg El autor cerró los comentarios para esta publicación.
        else
          div.add-comment
            form.add-comment(action=`/publicacion/${foto.id_publicacion || foto.id}/comentario` method="POST")
              input.add-comment(type="text" name="contenido" placeholder="Escribe un comentario...")
              button.btn-send-comment Enviar

          div.comments-list
          if foto.comentarios && foto.comentarios.length > 0
            each c in foto.comentarios
              div.comment-item
                div.comment-avatar
                  | #{c.usuario && c.usuario.nombre_usuario ? c.usuario.nombre_usuario.charAt(0).toUpperCase() : 'U'}
                div.comment-body
                  div.comment-meta
                    if c.usuario && c.usuario.id_usuario
                      a(href=`/usuario/${c.usuario.id_usuario}` style="color: #63b3ed; text-decoration: none;")
                        span.comment-author @#{c.usuario.nombre_usuario}
                    else
                      span.comment-author @anónimo
                  p.comment-text= c.contenido
                  span.comment-date
                    - const fecha = new Date(c.fecha_creacion || c.createdAt);
                    | Comentado el #{fecha.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute:'2-digit' })}
          else
            p.comments-placeholder No hay comentarios aún. ¡Sé el primero en comentar!

  script.
    function changeImage(url) {
        document.getElementById('current-image').src = url;
      }
    document.querySelectorAll('.star-icon').forEach(star => {
      star.addEventListener('click', function() {
        const nuevoVoto = this.getAttribute('data-value');

        if (confirm(`¿Confirmar valoración de ${nuevoVoto} estrellas?`)) {
          document.getElementById('puntuacion-input').value = nuevoVoto;
          
          fetch(document.getElementById('form-valorar').action, {
              method: 'POST',
              body: new URLSearchParams(new FormData(document.getElementById('form-valorar')))
          })
          .then(res => res.json())
          .then(data => {
              // Actualizamos promedio y estrellas
              document.getElementById('rating-display').innerText = 
                  `${data.nuevoPromedio} (${data.nuevaCantidad})`;

              document.querySelectorAll('.star-icon').forEach(s => s.classList.remove('selected'));
              
              // Buscamos la estrella con el valor del voto recién guardado
              document.querySelectorAll('.star-icon').forEach(s => {
                  if(parseInt(s.getAttribute('data-value')) <= parseInt(nuevoVoto)) {
                      s.classList.add('selected');
                  }
              });

              // Toast
              const toast = document.createElement('div');
              toast.className = 'toast-container';
              toast.innerHTML = '<div class="toast-msg">¡Valoración guardada!</div>';
              document.body.appendChild(toast);
              setTimeout(() => toast.remove(), 3000);
          });
        }
      });
    });