extends layout

block content
  h1= titulo
  p Bienvenidos a la primera versión del TPI con Base de Datos Real!

  div(style="display: flex; gap: 20px; flex-wrap: wrap; margin-top: 20px;")
    
    if publicaciones && publicaciones.length > 0
      each foto in publicaciones
        div(style="background: #1a1a1a; padding: 15px; border-radius: 8px; width: 300px; border: 1px solid #333;")
          
          img(src=foto.rutas_archivos, alt=foto.titulo, style="width: 100%; height: 200px; object-fit: cover; border-radius: 4px;")
          
          h3(style="color: #00ff88; margin: 10px 0 5px 0;")= foto.titulo
          p(style="color: #ccc; font-size: 14px; margin-bottom: 10px;")= foto.descripcion
          
          if foto.etiquetas
            p(style="color: #888; font-size: 12px;") 🏷️ Etiquetas: #{foto.etiquetas}
    else
      p No hay publicaciones disponibles en este momento.