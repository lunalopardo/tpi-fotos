extends layout

block content
  h1.page-title= titulo
  p.page-subtitle ¡Bienvenidos a la primera versión del TPI!

  div.gallery-grid
    if publicaciones && publicaciones.length > 0
      each foto in publicaciones
        div.photo-card
          img.photo-img(src=foto.rutas_archivos, alt=foto.titulo)
          h3.photo-title= foto.titulo
          p.photo-desc= foto.descripcion
          
          if foto.etiquetas
            p.photo-tags 🏷️ Etiquetas: #{foto.etiquetas}
    else
      p No hay publicaciones disponibles en este momento.