extends layout

block content
  div.gallery-grid
    if publicaciones && publicaciones.length > 0
      each foto in publicaciones
        div.photo-card
          a(href=`/publicacion/${foto.id_publicacion}`)
            div.photo-img-wrapper(style="position: relative;")
              if foto.imagenes && foto.imagenes.length > 0
                img.photo-img(src=foto.imagenes[0], alt=foto.titulo)
              else
                div(style="padding: 40px 20px; text-align: center; background: #1a1d24; color: #a0aec0; border-radius: 8px;") Imagen no disponible

              if foto.imagenes && foto.imagenes.length > 1
                div.gallery-badge
                  <span>+#{foto.imagenes.length - 1}</span>

          div.photo-info
            h3.photo-title
              a(href=`/publicacion/${foto.id_publicacion}` style="color: inherit; text-decoration: none;")= foto.titulo

            p.photo-author
              if foto.usuario && foto.usuario.nombre_usuario
                | @#{foto.usuario.nombre_usuario}
              else
                | @fotografo

            div.photo-card-footer
              if foto.copyright === 1
                span.photo-copyright-status Con Copyright
              else
                span.photo-copyright-status Sin Copyright
    else
      p.page-subtitle No hay publicaciones disponibles en este momento.